{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "allowMessagePatterns": [
            "/postgres:\\/\\/(test|postgres):.*@(localhost|127\\.0\\.0\\.1).*\\/(test|leaflock|notes)/",
            "/postgres:\\/\\/(test|postgres):(test|postgres|testpass123)@/",
            "/__tests__/",
            "/_test\\.go$/",
            "/_integration_test\\.go$/",
            "/\\.test\\./",
            "/TEST_DB_URL/",
            "/testDBURL/",
            "/badURL/",
            "/Makefile/",
            "/backend\\/auth\\/handlers_integration_test\\.go/",
            "/backend\\/config\\/config_test\\.go/"
          ]
        }
      ]
    }
  ]
}
