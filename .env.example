# ==========================================
# LeafLock Environment Configuration
# ==========================================
# Copy this to .env and update with your values

# ==========================================
# Core Application Settings
# ==========================================
# Environment: development, production, or test
# In development: *.railway.app allowed, debug features enabled
APP_ENV=development

# ==========================================
# Database (PostgreSQL)
# ==========================================
# If using Docker: POSTGRES_PASSWORD is used by the postgres service
POSTGRES_PASSWORD=postgres
# Full connection string (includes the password above)
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5432/leaflock?sslmode=disable

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# Clerk Authentication (REQUIRED)
# ==========================================
# Get from: https://dashboard.clerk.com
# Test keys enable test mode automatically
# Test emails: user+clerk_test@example.com
# Test verification code: 424242
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ==========================================
# Security & Features
# ==========================================
# Allow public user registration
ENABLE_REGISTRATION=true

# Comma-separated allowed origins for CORS
# Examples: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Enable metrics collection
ENABLE_METRICS=true

# ==========================================
# Email (Production Only)
# ==========================================
# Set SMTP_ENABLED=true to enable password reset emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM="LeafLock <noreply@yourdomain.com>"
# FRONTEND_URL=https://yourdomain.com

# ==========================================
# Development Admin (Optional)
# ==========================================
# Auto-creates admin account on first startup
# ENABLE_DEFAULT_ADMIN=true
# DEFAULT_ADMIN_EMAIL=admin@leaflock.local
# DEFAULT_ADMIN_PASSWORD=ChangeThisAdminPassword123!

# ==========================================
# Frontend URLs (Advanced)
# ==========================================
# Leave empty for auto-detection (recommended)
# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080
