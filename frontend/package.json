{
  "name": "leaflock-frontend",
  "version": "0.0.1-rc.20250910210438",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "sh scripts/check-no-jsx.sh && vite build",
    "preview": "vite preview",
    "lint": "sh scripts/check-no-jsx.sh && eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"**/*.{js,ts,tsx,css}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"**/*.{js,ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS=--max-old-space-size=16384 vitest run --pool=threads --max-workers=1",
    "test:watch": "vitest",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=16384 vitest run --coverage --pool=threads --max-workers=1",
    "test:ui": "vitest --ui",
    "test:security": "vitest run src/**/*.test.js --reporter=verbose",
    "test:e2e": "vitest run src/e2e.test.js",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "clean": "rm -rf dist node_modules/.vite coverage",
    "analyze": "vite build --mode analyze",
    "serve": "vite preview",
    "lhci": "sh scripts/lighthouse-check.sh",
    "check-all": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test"
  },
